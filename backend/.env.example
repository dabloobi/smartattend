# Database Configuration for SmartAttend (Template)
DB_HOST=localhost
DB_NAME=smartattend_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00
APP_SECRET=change_this_to_a_random_32_character_secret_key
CORS_ALLOWED_ORIGIN=http://localhost:5173

# PHPMailer / SMTP Configuration
SMTP_HOST=mail.smartattend.website
SMTP_PORT=465
SMTP_USER=_mainaccount@smartattend.website
SMTP_PASS=your_email_password
SMTP_SECURE=ssl
SMTP_FROM_EMAIL=_mainaccount@smartattend.website
SMTP_FROM_NAME=SmartAttend System
